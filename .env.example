# Auth0 Configuration
# Auth0のダッシュボードから取得した値を設定してください
# https://manage.auth0.com/

# Auth0のドメイン（例: your-tenant.us.auth0.com）
AUTH0_DOMAIN=your-auth0-domain.auth0.com

# Auth0のクライアントID
AUTH0_CLIENT_ID=your-client-id

# Auth0のクライアントシークレット
AUTH0_CLIENT_SECRET=your-client-secret

# アプリケーションのベースURL（開発環境）
BASE_URL=http://localhost:5173

# セッション暗号化用のシークレット（32文字以上のランダム文字列）
AUTH0_SESSION_ENCRYPTION_KEY=your-session-secret-min-32-characters-long

# Auth0 API Audience（オプション）
# AUTH0_AUDIENCE=https://api.yourapp.com
