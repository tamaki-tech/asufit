{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "asufit",
	"main": "./.cloudflare/worker.js",
	"build": {
		"command": "npm run build"
	},
	"assets": {
		"directory": ".svelte-kit/cloudflare",
